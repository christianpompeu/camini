# camini — chaves locais dos providers LLM (NÃO COMMITAR).
# Este arquivo é lido pelo Next.js no boot do servidor (reinicie npm run dev após editar).
# As chaves aqui têm PRIORIDADE sobre as chaves salvas no navegador (localStorage).
# Preencha apenas as que você for usar:

# Google AI Studio — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq Console — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase (Acesse seu projeto > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==========================================
# ETAPA 1: ROTEADOR SEMÂNTICO (Triagem)
# ==========================================
GEMINI_ROUTER_MODEL="gemini-3.6-flash"
GROQ_ROUTER_MODEL="meta-llama/llama-prompt-guard-2-86m"

# ==========================================
# ETAPA 2: GERADOR T-SQL (Geração de Código)
# ==========================================
# Usaremos o Flash também como gerador, pois ele tem cota liberada
GEMINI_GENERATOR_MODEL="gemini-3.6-flash"
# Voltamos para o modelo OSS-120b que sabemos que existe no seu gateway, 
# e que agora vai funcionar porque reduzimos o tamanho do dicionário.
GROQ_GENERATOR_MODEL="openai/gpt-oss-120b"